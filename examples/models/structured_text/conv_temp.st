VAR
    (* Buffer allocation variables *)
    buffer_0 : ARRAY[0..79] OF REAL;
    buffer_1 : ARRAY[0..79] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    sum : REAL;
    (* Spatial loop variables for Conv / Pool layers *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
