(* Layer 0: Conv2D  in=1x1x5  out=8x1x5  kernel=1x3  stride=1x1  pad=(0, 1, 0, 1)  group=1 *)
FOR oc := 0 TO 7 DO
    FOR oh := 0 TO 0 DO
        FOR ow := 0 TO 4 DO
            sum := bias_0[oc];
            FOR ic := 0 TO 0 DO
                FOR kh := 0 TO 0 DO
                    FOR kw := 0 TO 2 DO
                        ih := oh * 1 - 0 + kh;
                        iw := ow * 1 - 1 + kw;
                        IF (ih >= 0) AND (ih < 1) AND (iw >= 0) AND (iw < 5) THEN
                            sum := sum + input_data[ic * 5 + ih * 5 + iw] * weights_0[oc * 3 + ic * 3 + kh * 3 + kw];
                        END_IF;
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 5 + oh * 5 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 1: Activation (RELU) *)
FOR i := 0 TO 39 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 2: Conv2D  in=8x1x5  out=16x1x5  kernel=1x3  stride=1x1  pad=(0, 1, 0, 1)  group=1 *)
FOR oc := 0 TO 15 DO
    FOR oh := 0 TO 0 DO
        FOR ow := 0 TO 4 DO
            sum := bias_2[oc];
            FOR ic := 0 TO 7 DO
                FOR kh := 0 TO 0 DO
                    FOR kw := 0 TO 2 DO
                        ih := oh * 1 - 0 + kh;
                        iw := ow * 1 - 1 + kw;
                        IF (ih >= 0) AND (ih < 1) AND (iw >= 0) AND (iw < 5) THEN
                            sum := sum + buffer_0[ic * 5 + ih * 5 + iw] * weights_2[oc * 24 + ic * 3 + kh * 3 + kw];
                        END_IF;
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 5 + oh * 5 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 3: Activation (RELU) *)
FOR i := 0 TO 79 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 4: MaxPool  kernel=1x2  stride=1x2 *)
FOR oc := 0 TO 15 DO
    FOR oh := 0 TO 0 DO
        FOR ow := 0 TO 1 DO
            sum := -3.402823E+38;
            FOR kh := 0 TO 0 DO
                FOR kw := 0 TO 1 DO
                    ih := oh * 1 - 0 + kh;
                    iw := ow * 2 - 0 + kw;
                    IF buffer_0[oc * 5 + ih * 5 + iw] > sum THEN
                        sum := buffer_0[oc * 5 + ih * 5 + iw];
                    END_IF;
                END_FOR;
            END_FOR;
            buffer_1[oc * 2 + oh * 2 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 5: Transpose perm=(1, 2, 0)  (16, 1, 2) -> (1, 2, 16) *)
FOR t5_d0 := 0 TO 0 DO
    FOR t5_d1 := 0 TO 1 DO
        FOR t5_d2 := 0 TO 15 DO
            buffer_0[t5_d0 * 32 + t5_d1 * 16 + t5_d2] := buffer_1[t5_d2 * 2 + t5_d0 * 2 + t5_d1];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 6: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 31 DO
        sum := sum + buffer_0[i] * weights_6[i * 16 + j];
    END_FOR;
    buffer_1[j] := MAX(sum + bias_6[j], 0.0);
END_FOR;

(* Layer 7: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_7[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_7[j];
END_FOR;

max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

