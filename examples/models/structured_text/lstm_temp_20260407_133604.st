(* Initialize LSTM states to zero *)
FOR j := 0 TO 31 DO
    h_state_6[j] := 0.0;
    c_state_6[j] := 0.0;
END_FOR;

(* Process sequence: 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Input Gate: i_t = sigmoid(W_i @ x_t + R_i @ h_{t-1} + b_i) *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
