    buffer_2[i] := input_data[i];
END_FOR;

(* Layer 2: Transpose perm=(0, 1)  (20, 1) -> (20, 1) *)
FOR t2_d0 := 0 TO 19 DO
    FOR t2_d1 := 0 TO 0 DO
        buffer_0[t2_d0 + t2_d1] := input_data[t2_d0 + t2_d1];
    END_FOR;
