        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_6[i] * recurrent_6_i[j * 32 + i];
        END_FOR;
        sum := sum + bias_6_i[j];
        i_gate_6[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate: f_t = sigmoid(W_f @ x_t + R_f @ h_{t-1} + b_f) *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_0[t * 1 + i] * weights_6_f[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_6[i] * recurrent_6_f[j * 32 + i];
        END_FOR;
        sum := sum + bias_6_f[j];
        f_gate_6[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate: g_t = tanh(W_g @ x_t + R_g @ h_{t-1} + b_g) *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_0[t * 1 + i] * weights_6_g[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_6[i] * recurrent_6_g[j * 32 + i];
        END_FOR;
        sum := sum + bias_6_g[j];
        exp_val := EXP(2.0 * sum);
        g_gate_6[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate: o_t = sigmoid(W_o @ x_t + R_o @ h_{t-1} + b_o) *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_0[t * 1 + i] * weights_6_o[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_6[i] * recurrent_6_o[j * 32 + i];
        END_FOR;
        sum := sum + bias_6_o[j];
        o_gate_6[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell State: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 31 DO
