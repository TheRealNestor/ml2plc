VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..119] OF REAL;
    buffer_1 : ARRAY[0..119] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
    (* Transpose loop variables *)
    t2_d0 : DINT;
    t2_d1 : DINT;
    t2_d2 : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Conv2D  in=1x20x1  out=6x20x1  kernel=3x1  stride=1x1  pad=(1, 0, 1, 0)  group=1 *)
FOR oc := 0 TO 5 DO
    FOR oh := 0 TO 19 DO
        FOR ow := 0 TO 0 DO
            sum := bias_0[oc];
            FOR ic := 0 TO 0 DO
                FOR kh := 0 TO 2 DO
                    FOR kw := 0 TO 0 DO
                        ih := oh * 1 - 1 + kh;
                        iw := ow * 1 - 0 + kw;
                        IF (ih >= 0) AND (ih < 20) AND (iw >= 0) AND (iw < 1) THEN
                            sum := sum + input_data[ic * 20 + ih * 1 + iw] * weights_0[oc * 3 + ic * 3 + kh * 1 + kw];
                        END_IF;
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 20 + oh * 1 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 1: Activation (RELU) *)
FOR i := 0 TO 119 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 2: Transpose perm=(1, 2, 0)  (6, 20, 1) -> (20, 1, 6) *)
FOR t2_d0 := 0 TO 19 DO
    FOR t2_d1 := 0 TO 0 DO
        FOR t2_d2 := 0 TO 5 DO
            buffer_1[t2_d0 * 6 + t2_d1 * 6 + t2_d2] := buffer_0[t2_d2 * 20 + t2_d0 + t2_d1];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 3: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 119 DO
        sum := sum + buffer_1[i] * weights_3[i * 16 + j];
    END_FOR;
    buffer_0[j] := MAX(sum + bias_3[j], 0.0);
END_FOR;

(* Layer 4: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_0[i] * weights_4[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_4[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

