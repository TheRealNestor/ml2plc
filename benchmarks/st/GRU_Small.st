(* Layer 1: GRU (hidden_size=16, input_size=1, seq_len=20) *)
(* Generating output: Y, linear_before_reset=1 *)

(* Initialize states to zero *)
FOR j := 0 TO 15 DO
    h_state_1[j] := 0.0;
END_FOR;

(* Process 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Reset Gate *)
    FOR j := 0 TO 15 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_r[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 15 DO
            sum := sum + h_state_1[i] * recurrent_1_r[j * 16 + i];
        END_FOR;
        sum := sum + bias_1_r[j];
        r_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Update Gate *)
    FOR j := 0 TO 15 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_u[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 15 DO
            sum := sum + h_state_1[i] * recurrent_1_u[j * 16 + i];
        END_FOR;
        sum := sum + bias_1_u[j];
        u_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Candidate (lbr=1): h'_t = tanh(Wx + r_t * (Rh + Rb_h) + Wb_h) *)
    FOR j := 0 TO 15 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_h[j * 1 + i];
        END_FOR;
        exp_val := 0.0;
        FOR i := 0 TO 15 DO
            exp_val := exp_val + h_state_1[i] * recurrent_1_h[j * 16 + i];
        END_FOR;
        sum := sum + r_gate_1[j] * (exp_val + bias_r_1_h[j]);
        sum := sum + bias_w_1_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_1[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 15 DO
        h_state_1[j] := u_gate_1[j] * h_state_1[j] + (1.0 - u_gate_1[j]) * h_new_1[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 15 DO
        buffer_0[t * 16 + j] := h_state_1[j];
    END_FOR;
END_FOR;

(* Layer 2: Squeeze *)
FOR i := 0 TO 319 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 3: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 15 DO
    buffer_0[i] := buffer_1[i + 304];
END_FOR;

(* Layer 4: Squeeze *)
FOR i := 0 TO 15 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 5: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_5[i * 3 + j];
    END_FOR;
    buffer_0[j] := sum;
END_FOR;

(* Layer 6: Activation (SOFTMAX) *)
(* Softmax: find max *)
max_val := buffer_0[0];
FOR i := 1 TO 2 DO
    IF buffer_0[i] > max_val THEN
        max_val := buffer_0[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(buffer_0[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
