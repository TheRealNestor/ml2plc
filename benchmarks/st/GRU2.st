    weights_5 : ARRAY[0..107] OF REAL := [-0.411296099, -0.684209883, 0.771582663, -0.742775619, 0.0563872606, 2.30369949, 0.120057777, 0.452301323, -0.821960866, 0.134378463, -0.184406266, 0.407066226, 1.55788422, 0.133470908, -1.62073135, -0.065779753, -0.631012559, 0.840767622, 0.21829401, -0.166514009, 0.113081343, 1.23260021, 0.0967188701, -2.05887341, 0.553433895, 0.512023866, -0.953813255, -1.30639088, -0.125149205, 0.487071872, -1.68089044, 0.30630219, 0.712787092, -1.93336999, 0.14779678, 1.22403288, 0.657337129, 0.37243402, -1.30198324, 0.633335054, -0.558393836, -0.391238242, 1.31069601, -0.796183705, -0.5672369, -0.198813334, 0.481328487, 0.248451129, 0.782138824, -0.011287597, -1.14795315, -0.368216515, -0.567988694, 1.30054295, -0.500766397, 0.571454525, -0.130560979, 0.726179242, -0.281182468, -0.837824225, 0.92365855, 0.279569566, -1.06084979, -1.96314037, -0.25256604, 1.53005362, 2.07408023, -0.576786041, -1.19785595, -1.36961734, 0.527572215, 0.895362198, 0.23402302, 0.51236999, -0.676661491, -0.346010298, -0.177872285, 1.42638314, 1.47648883, -0.506224573, -1.32911229, 0.91665554, -1.08560491, 0.348953038, -1.56113768, 0.204250485, 0.71235162, -0.194670692, 0.0759420544, 0.405287325, 0.16021286, -0.711884439, 0.405074298, -0.619217455, -0.458939523, 1.07795691, -1.93763101, 0.178735986, 1.73566055, -1.19897592, -0.129490241, 1.38471973, -0.213086843, 0.443654507, -0.484101206, -1.41394961, 0.758449554, 0.89101249];
    bias_5 : ARRAY[0..2] OF REAL := [0.179506376, 0.0461904407, -0.302100062];

