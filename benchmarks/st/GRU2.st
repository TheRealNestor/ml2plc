    weights_5 : ARRAY[0..107] OF REAL := [-0.0398823917, -0.109167248, 0.27160266, -0.320021033, 0.013071686, 0.207740575, 0.0637018979, -0.357031941, 0.0782178342, 0.214736849, 0.130482286, 0.288097173, 0.276217669, 0.230798095, -0.258725852, -0.370599151, 0.269584984, 0.339711159, 0.258033484, -0.347947836, 0.214710861, 0.0872266293, 0.0330651104, 0.371306866, -0.384014308, -0.224822104, -0.230698243, -0.296379954, 0.0675444305, -0.0775782764, -0.266108453, -0.033839047, -0.0984407365, -0.149975225, 0.376505226, 0.326406151, 0.282335073, -0.386873752, 0.214800328, -0.208577439, 0.315547258, -0.0628642738, 0.113074392, -0.377370894, -0.0467372537, 0.210590929, -0.290636331, -0.203290641, 0.164968282, -0.0257501304, -0.0472553372, -0.161336422, -0.216182962, 0.0153905749, 0.0797090232, 0.25465849, -0.238897681, -0.000269323587, -0.386950523, -0.28013435, -0.343763024, 0.272944063, -0.298949659, 0.326573759, 0.34137395, 0.188319534, 0.19976607, 0.0513186753, -0.0730867386, 0.135630518, -0.264310896, -0.194389746, -0.0203047395, -0.368157178, 0.323895186, -0.134578943, -0.384849966, -0.018527925, -0.215237245, 0.0915651023, -0.343723834, 0.37840566, 0.0688827336, -0.201395273, -0.366522163, -0.263664782, -0.287168205, -0.248583362, -0.369812965, 0.290247649, 0.310777336, 0.169291943, -0.214575052, 0.387902111, -0.303804219, -0.0752461851, -0.196773171, 0.15922609, 0.301769346, 0.381528229, 0.0422447622, 0.128995627, 0.0782860816, -0.01237005, 0.344513565, -0.261437804, 0.133613795, 0.118129402];


