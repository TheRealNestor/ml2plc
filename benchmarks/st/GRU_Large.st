            exp_val := exp_val + h_state_5[i] * recurrent_5_h[j * 26 + i];
        END_FOR;
        sum := sum + r_gate_5[j] * (exp_val + bias_r_5_h[j]);
        sum := sum + bias_w_5_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_5[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 25 DO
        h_state_5[j] := u_gate_5[j] * h_state_5[j] + (1.0 - u_gate_5[j]) * h_new_5[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 25 DO
        buffer_1[t * 26 + j] := h_state_5[j];
    END_FOR;
END_FOR;

(* Layer 6: Squeeze *)
FOR i := 0 TO 519 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 7: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 25 DO
    buffer_1[i] := buffer_0[i + 494];
END_FOR;

(* Layer 8: Squeeze *)
FOR i := 0 TO 25 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 9: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 25 DO
        sum := sum + buffer_0[i] * weights_9[i * 3 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 10: Activation (SOFTMAX) *)
(* Softmax: find max *)
max_val := buffer_1[0];
FOR i := 1 TO 2 DO
    IF buffer_1[i] > max_val THEN
        max_val := buffer_1[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(buffer_1[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
