(* Layer 4: Transpose perm=(1, 2, 0)  (16, 20, 1) -> (20, 1, 16) *)
FOR t4_d0 := 0 TO 19 DO
    FOR t4_d1 := 0 TO 0 DO
        FOR t4_d2 := 0 TO 15 DO
            buffer_1[t4_d0 * 16 + t4_d1 * 16 + t4_d2] := buffer_0[t4_d2 * 20 + t4_d0 + t4_d1];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 5: MatMul *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 319 DO
        sum := sum + buffer_1[i] * weights_5[i * 16 + j];
    END_FOR;
    buffer_0[j] := sum;
END_FOR;

(* Layer 6: Activation (RELU) *)
FOR i := 0 TO 15 DO
    buffer_1[i] := MAX(buffer_0[i], 0.0);
END_FOR;

(* Layer 7: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_7[i * 3 + j];
    END_FOR;
    buffer_0[j] := sum;
END_FOR;

(* Layer 8: Activation (SOFTMAX) *)
(* Softmax: find max *)
max_val := buffer_0[0];
FOR i := 1 TO 2 DO
    IF buffer_0[i] > max_val THEN
        max_val := buffer_0[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(buffer_0[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
