VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..7] OF REAL;
    buffer_1 : ARRAY[0..7] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: MatMul *)
FOR j := 0 TO 7 DO
    sum := 0.0;
    FOR i := 0 TO 19 DO
        sum := sum + input_data[i] * weights_0[i * 8 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 1: Activation (RELU) *)
FOR i := 0 TO 7 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 2: MatMul *)
FOR j := 0 TO 7 DO
    sum := 0.0;
    FOR i := 0 TO 7 DO
        sum := sum + buffer_0[i] * weights_2[i * 8 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 3: Activation (RELU) *)
FOR i := 0 TO 7 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 4: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 7 DO
        sum := sum + buffer_0[i] * weights_4[i * 3 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 5: Activation (SOFTMAX) *)
(* Softmax: find max *)
max_val := buffer_1[0];
FOR i := 1 TO 2 DO
    IF buffer_1[i] > max_val THEN
        max_val := buffer_1[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(buffer_1[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

