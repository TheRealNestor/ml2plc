    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 4: Transpose perm=(1, 2, 0)  (10, 20, 1) -> (20, 1, 10) *)
FOR t4_d0 := 0 TO 19 DO
    FOR t4_d1 := 0 TO 0 DO
        FOR t4_d2 := 0 TO 9 DO
            buffer_1[t4_d0 * 10 + t4_d1 * 10 + t4_d2] := buffer_0[t4_d2 * 20 + t4_d0 + t4_d1];
        END_FOR;
