(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Conv2D  in=1x20x1  out=10x20x1  kernel=3x1  stride=1x1  pad=(1, 0, 1, 0)  group=1 *)
FOR oc := 0 TO 9 DO
    FOR oh := 0 TO 19 DO
        FOR ow := 0 TO 0 DO
            sum := bias_0[oc];
            FOR ic := 0 TO 0 DO
                FOR kh := 0 TO 2 DO
                    FOR kw := 0 TO 0 DO
                        ih := oh * 1 - 1 + kh;
                        iw := ow * 1 - 0 + kw;
                        IF (ih >= 0) AND (ih < 20) AND (iw >= 0) AND (iw < 1) THEN
                            sum := sum + input_data[ic * 20 + ih * 1 + iw] * weights_0[oc * 3 + ic * 3 + kh * 1 + kw];
                        END_IF;
                    END_FOR;
                END_FOR;
