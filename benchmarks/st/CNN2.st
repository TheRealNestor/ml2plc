(* Acyclic Region r0 *)
(* Layer 0: Conv2D  in=1x20x1  out=10x20x1  kernel=3x1  stride=1x1  pad=(1, 0, 1, 0)  group=1 *)
FOR oc := 0 TO 9 DO
    FOR oh := 0 TO 19 DO
        FOR ow := 0 TO 0 DO
            sum := bias_0[oc];
            FOR ic := 0 TO 0 DO
                FOR kh := 0 TO 2 DO
