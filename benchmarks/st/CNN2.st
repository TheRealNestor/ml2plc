FOR oc := 0 TO 9 DO
    FOR oh := 0 TO 19 DO
        FOR ow := 0 TO 0 DO
            sum := bias_2[oc];
            FOR ic := 0 TO 9 DO
                FOR kh := 0 TO 2 DO
                    FOR kw := 0 TO 0 DO
