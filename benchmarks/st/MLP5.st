(* Layer 8: Fused Linear + RELU *)
FOR j := 0 TO 7 DO
    sum := 0.0;
    FOR i := 0 TO 7 DO
        sum := sum + buffer_0[i] * weights_8[i * 8 + j];
    END_FOR;
    buffer_1[j] := MAX(sum + bias_8[j], 0.0);
END_FOR;

(* Layer 9: Fused Linear + RELU *)
FOR j := 0 TO 7 DO
    sum := 0.0;
    FOR i := 0 TO 7 DO
        sum := sum + buffer_1[i] * weights_9[i * 8 + j];
    END_FOR;
    buffer_0[j] := MAX(sum + bias_9[j], 0.0);
END_FOR;

(* Layer 10: Fused Linear + RELU *)
FOR j := 0 TO 7 DO
    sum := 0.0;
    FOR i := 0 TO 7 DO
        sum := sum + buffer_0[i] * weights_10[i * 8 + j];
    END_FOR;
    buffer_1[j] := MAX(sum + bias_10[j], 0.0);
END_FOR;

(* Layer 11: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 7 DO
        sum := sum + buffer_1[i] * weights_11[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_11[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
