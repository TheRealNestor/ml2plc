, 0.29422769, 0.10739737, -1.41223896, 0.649414062, -0.643171132, -0.522835255, -1.03872299, 0.295653701, 0.238539949, -0.983770192, -0.0467251316, 0.652209818, -1.20822513, 0.280628711, 0.424625039, 0.651492894, -0.0653450042, -0.840883672, 0.216302752, 0.337165117, -0.735296786, 0.492337137, 0.0584631562, -0.984342575, -0.398371667, -0.402030408, 0.984969437, 0.0396295451, 0.169898957, -0.939130604, 0.39757359, -0.11080569, -1.13883698, 1.13837695, -0.196109191, -0.497420758, 1.28587544, -0.145167932, -0.32784754, 1.05899477, -0.186796635, -0.798986495, 1.15046477, -0.573861241, -0.680492818];
