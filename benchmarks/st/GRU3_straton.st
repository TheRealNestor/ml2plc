VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..63] OF REAL;
    buffer_1 : ARRAY[0..63] OF REAL;
    h_new_0 : ARRAY[0..63] OF REAL;
    h_new_3 : ARRAY[0..63] OF REAL;
    h_state_0 : ARRAY[0..63] OF REAL;
    h_state_3 : ARRAY[0..63] OF REAL;
    r_gate_0 : ARRAY[0..63] OF REAL;
    r_gate_3 : ARRAY[0..63] OF REAL;
    u_gate_0 : ARRAY[0..63] OF REAL;
    u_gate_3 : ARRAY[0..63] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
    (* Transpose loop variables *)
    t2_d0 : DINT;
    t2_d1 : DINT;
    t2_d2 : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: GRU (hidden_size=64, input_size=1, seq_len=1) *)
(* Generating output: Y, linear_before_reset=1 *)

(* Initialize states to zero *)
FOR j := 0 TO 63 DO
    h_state_0[j] := 0.0;
END_FOR;

(* Process 1 timesteps *)
FOR t := 0 TO 0 DO

    (* Reset Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + input_data[t * 1 + i] * weights_0_r[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_0[i] * recurrent_0_r[j * 64 + i];
        END_FOR;
        sum := sum + bias_0_r[j];
        r_gate_0[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Update Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + input_data[t * 1 + i] * weights_0_u[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_0[i] * recurrent_0_u[j * 64 + i];
        END_FOR;
        sum := sum + bias_0_u[j];
        u_gate_0[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Candidate (lbr=1): h'_t = tanh(Wx + r_t * (Rh + Rb_h) + Wb_h) *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + input_data[t * 1 + i] * weights_0_h[j * 1 + i];
        END_FOR;
        exp_val := 0.0;
        FOR i := 0 TO 63 DO
            exp_val := exp_val + h_state_0[i] * recurrent_0_h[j * 64 + i];
        END_FOR;
        sum := sum + r_gate_0[j] * (exp_val + bias_r_0_h[j]);
        sum := sum + bias_w_0_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_0[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 63 DO
        h_state_0[j] := u_gate_0[j] * h_state_0[j] + (1.0 - u_gate_0[j]) * h_new_0[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_0[t * 64 + j] := h_state_0[j];
    END_FOR;
END_FOR;

(* Layer 1: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 2: Transpose perm=(1, 0, 2)  (1, 1, 64) -> (1, 1, 64) *)
FOR t2_d0 := 0 TO 0 DO
    FOR t2_d1 := 0 TO 0 DO
        FOR t2_d2 := 0 TO 63 DO
            buffer_0[t2_d0 * 64 + t2_d1 * 64 + t2_d2] := buffer_1[t2_d1 * 64 + t2_d0 * 64 + t2_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 3: GRU (hidden_size=64, input_size=64, seq_len=1) *)
(* Generating output: Y, linear_before_reset=1 *)

(* Initialize states to zero *)
FOR j := 0 TO 63 DO
    h_state_3[j] := 0.0;
END_FOR;

(* Process 1 timesteps *)
FOR t := 0 TO 0 DO

    (* Reset Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_3_r[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_3[i] * recurrent_3_r[j * 64 + i];
        END_FOR;
        sum := sum + bias_3_r[j];
        r_gate_3[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Update Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_3_u[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_3[i] * recurrent_3_u[j * 64 + i];
        END_FOR;
        sum := sum + bias_3_u[j];
        u_gate_3[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Candidate (lbr=1): h'_t = tanh(Wx + r_t * (Rh + Rb_h) + Wb_h) *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_3_h[j * 64 + i];
        END_FOR;
        exp_val := 0.0;
        FOR i := 0 TO 63 DO
            exp_val := exp_val + h_state_3[i] * recurrent_3_h[j * 64 + i];
        END_FOR;
        sum := sum + r_gate_3[j] * (exp_val + bias_r_3_h[j]);
        sum := sum + bias_w_3_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_3[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 63 DO
        h_state_3[j] := u_gate_3[j] * h_state_3[j] + (1.0 - u_gate_3[j]) * h_new_3[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_1[t * 64 + j] := h_state_3[j];
    END_FOR;
END_FOR;

(* Layer 4: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 5: Slice starts=[0] ends=[1] axes=[0] steps=[1] *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 6: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 7: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_7[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_7[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

