(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: MatMul *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 19 DO
        sum := sum + input_data[i] * weights_0[i * 16 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 1: Activation (RELU) *)
FOR i := 0 TO 15 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 2: MatMul *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_0[i] * weights_2[i * 16 + j];
    END_FOR;
    buffer_2[j] := sum;
END_FOR;

(* Layer 3: Activation (RELU) *)
FOR i := 0 TO 15 DO
    buffer_1[i] := MAX(buffer_2[i], 0.0);
END_FOR;

(* Layer 4: MatMul *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_4[i * 16 + j];
    END_FOR;
    buffer_2[j] := sum;
END_FOR;

(* Layer 5: Add (Element-wise) *)
FOR i := 0 TO 15 DO
    buffer_1[i] := buffer_2[i] + buffer_0[i];
END_FOR;

(* Layer 6: Activation (RELU) *)
FOR i := 0 TO 15 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 7: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_0[i] * weights_7[i * 3 + j];
    END_FOR;
    buffer_1[j] := sum;
