(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 0 DO
        sum := sum + input_data[i] * weights_0[i * 16 + j];
    END_FOR;
    buffer_0[j] := MAX(sum + bias_0[j], 0.0);
END_FOR;

(* Layer 1: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_0[i] * weights_1[i * 16 + j];
    END_FOR;
    buffer_2[j] := MAX(sum + bias_1[j], 0.0);
END_FOR;

(* Layer 2: MatMul *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_2[i] * weights_2[i * 16 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 3: Add (Bias) *)
FOR i := 0 TO 15 DO
    buffer_2[i] := buffer_1[i] + bias_3[i];
END_FOR;

(* Layer 4: Add (Element-wise) *)
FOR i := 0 TO 15 DO
    buffer_1[i] := buffer_2[i] + buffer_0[i];
END_FOR;

(* Layer 5: Activation (RELU) *)
FOR i := 0 TO 15 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 6: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_0[i] * weights_6[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_6[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

