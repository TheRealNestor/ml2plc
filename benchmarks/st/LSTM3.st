END_FOR;

(* Layer 3: Transpose perm=(1, 0, 2)  (20, 1, 64) -> (1, 20, 64) *)
FOR t3_d0 := 0 TO 0 DO
    FOR t3_d1 := 0 TO 19 DO
        FOR t3_d2 := 0 TO 63 DO
            buffer_2[t3_d0 * 1280 + t3_d1 * 64 + t3_d2] := buffer_1[t3_d1 * 64 + t3_d0 * 64 + t3_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 4: Transpose perm=(1, 0, 2)  (1, 20, 64) -> (20, 1, 64) *)
FOR t4_d0 := 0 TO 19 DO
    FOR t4_d1 := 0 TO 0 DO
        FOR t4_d2 := 0 TO 63 DO
            buffer_0[t4_d0 * 64 + t4_d1 * 64 + t4_d2] := buffer_2[t4_d1 * 1280 + t4_d0 * 64 + t4_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 5: LSTM (hidden_size=64, input_size=64, seq_len=20) *)
(* Generating output: Y *)

(* Initialize states to zero *)
FOR j := 0 TO 63 DO
    h_state_5[j] := 0.0;
    c_state_5[j] := 0.0;
END_FOR;

(* Process 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Input Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_i[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_i[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_i[j];
        i_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_f[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_f[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_f[j];
        f_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_g[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_g[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_g[j];
        exp_val := EXP(2.0 * sum);
        g_gate_5[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_o[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_o[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_o[j];
        o_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 63 DO
        c_state_5[j] := f_gate_5[j] * c_state_5[j] + i_gate_5[j] * g_gate_5[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 63 DO
        exp_val := EXP(2.0 * c_state_5[j]);
        h_state_5[j] := o_gate_5[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_1[t * 64 + j] := h_state_5[j];
    END_FOR;
END_FOR;

(* Layer 6: Squeeze *)
FOR i := 0 TO 1279 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 7: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i + 1216];
END_FOR;

(* Layer 8: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 9: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_9[i * 3 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 10: Activation (SOFTMAX) *)
(* Softmax: find max *)
max_val := buffer_1[0];
FOR i := 1 TO 2 DO
    IF buffer_1[i] > max_val THEN
        max_val := buffer_1[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(buffer_1[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
