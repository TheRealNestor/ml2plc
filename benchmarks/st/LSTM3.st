        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_i[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_i[j];
        i_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_f[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_f[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_f[j];
        f_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_g[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_g[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_g[j];
        exp_val := EXP(2.0 * sum);
        g_gate_5[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_o[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_o[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_o[j];
        o_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 63 DO
        c_state_5[j] := f_gate_5[j] * c_state_5[j] + i_gate_5[j] * g_gate_5[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 63 DO
        exp_val := EXP(2.0 * c_state_5[j]);
        h_state_5[j] := o_gate_5[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_1[t * 64 + j] := h_state_5[j];
    END_FOR;
END_FOR;

(* Layer 6: Squeeze *)
FOR i := 0 TO 1279 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 7: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i + 1216];
END_FOR;

(* Layer 8: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 9: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_9[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_9[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
