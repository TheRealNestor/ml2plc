    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 63 DO
        exp_val := EXP(2.0 * c_state_0[j]);
        h_state_0[j] := o_gate_0[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_0[t * 64 + j] := h_state_0[j];
    END_FOR;
END_FOR;

(* Layer 1: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 2: Transpose perm=(1, 0, 2)  (1, 1, 64) -> (1, 1, 64) *)
FOR t2_d0 := 0 TO 0 DO
    FOR t2_d1 := 0 TO 0 DO
        FOR t2_d2 := 0 TO 63 DO
            buffer_0[t2_d0 * 64 + t2_d1 * 64 + t2_d2] := buffer_1[t2_d1 * 64 + t2_d0 * 64 + t2_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 3: LSTM (hidden_size=64, input_size=64, seq_len=1) *)
(* Generating output: Y *)

(* Initialize states to zero *)
FOR j := 0 TO 63 DO
    h_state_3[j] := 0.0;
    c_state_3[j] := 0.0;
END_FOR;

(* Process 1 timesteps *)
FOR t := 0 TO 0 DO

    (* Input Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_3_i[j * 64 + i] ;
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_3[i] * recurrent_3_i[j * 64 + i] ;
        END_FOR;
    sum := sum + bias_3_i[j];
    i_gate_3[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_3_f[j * 64 + i] ;
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_3[i] * recurrent_3_f[j * 64 + i] ;
        END_FOR;
    sum := sum + bias_3_f[j];
    f_gate_3[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_3_g[j * 64 + i] ;
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_3[i] * recurrent_3_g[j * 64 + i] ;
        END_FOR;
    sum := sum + bias_3_g[j];
    exp_val := EXP(2.0 * sum);
    g_gate_3[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_3_o[j * 64 + i] ;
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_3[i] * recurrent_3_o[j * 64 + i] ;
        END_FOR;
    sum := sum + bias_3_o[j];
    o_gate_3[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 63 DO
        c_state_3[j] := f_gate_3[j] * c_state_3[j] + i_gate_3[j] * g_gate_3[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 63 DO
        exp_val := EXP(2.0 * c_state_3[j]);
        h_state_3[j] := o_gate_3[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_1[t * 64 + j] := h_state_3[j];
    END_FOR;
END_FOR;

(* Layer 4: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 5: Slice starts=[0] ends=[1] axes=[0] steps=[1] *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 6: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 7: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_7[i * 3 + j];
    END_FOR;
output_data[j] := sum + bias_7[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
