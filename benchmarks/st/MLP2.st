    bias_1 : ARRAY[0..11] OF REAL := [-0.0375626311, -0.591020405, 0.921454191, 0, 0.725169361, -0.251833826, -0.0172388218, 0, 0.822310686, 0, 0, 0.749954879];

    weights_2 : ARRAY[0..35] OF REAL := [0.597325504, 0.305420995, -0.48944959, -0.391156137, -2.17112041, 2.10054731, 0.8799631, 0.604366958, -2.2579844, 0.277502537, 0.338385344, 0.18559581, 2.05303097, -2.52683377, -1.09150839, -2.28318071, 0.401268154, 1.54289114, 0.420753717, 0.250676453, -0.16422537, -0.26104933, 0.184558988, -0.18064782, 0.678405464, 1.02316344, -1.90771019, 0.412688792, -0.146873921, -0.577244401, 0.539389789, -0.176821679, 0.457258284, 1.71602476, -2.6372664, -1.0096848];
    bias_2 : ARRAY[0..2] OF REAL := [0.00594961783, 0.432862461, -0.599440217];

END_VAR

VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..11] OF REAL;
    buffer_1 : ARRAY[0..15] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 0 DO
        sum := sum + input_data * weights_0[i * 16 + j];
    END_FOR;
buffer_1[j] := MAX(sum + bias_0[j], 0.0);
END_FOR;

(* Layer 1: Fused Linear + RELU *)
FOR j := 0 TO 11 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_1[i * 12 + j];
    END_FOR;
buffer_0[j] := MAX(sum + bias_1[j], 0.0);
END_FOR;

(* Layer 2: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 11 DO
        sum := sum + buffer_0[i] * weights_2[i * 3 + j];
    END_FOR;
output_data[j] := sum + bias_2[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
