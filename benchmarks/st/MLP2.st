    weights_1 : ARRAY[0..191] OF REAL := [0.407936037, 1.01749933, -1.20114148, -0.356967181, -1.92732286, 1.20346272, 0.0781332627, 0.110552192, -0.972595394, -0.313477427, -0.218291625, -1.12861526, 0.221315295, 1.45682728, -0.982407808, -0.285307944, -2.18309093, 1.60580647, 0.2185058, 0.064870894, -0.600545108, 0.315021992, -0.448407263, -1.79436421, 0.404721051, -0.0474102646, 0.0530464835, 0.124062717, -0.176960215, -0.155545041, 0.0506753214, -0.437269509, -0.228712574, -0.369052738, -0.429218858, 0.201358885, 0.28686437, 1.53200614, -1.35171425, 0.0549506545, -1.98245513, 1.03874934, -0.184130549, -0.166306764, -1.5724988, -0.127019316, -0.0215409696, -1.40627873, 0.374695808, 0.546456575, -1.01021481, -0.445112586, -1.66891205, 1.26654756, 0.188432008, -0.0941087306, -0.585701585, 0.377527773, -0.314398438, -1.73832321, -0.38970384, 1.36822653, -0.914057195, -0.0957710743, -1.70956862, 1.32042539, -0.0677670836, -0.0267109871, -0.637701869, 0.0480532646, 0.444410801, -0.946867883, -0.393403441, 0.742363334, -0.25676915, -0.0946780145, -0.875564277, 1.52547073, -0.397308588, -0.14911443, -0.00169039122, 0.104037285, 0.213252962, -0.845695674, -0.0459959507, -0.226814017, -0.0849841833, 0.202506483, 0.451363325, -0.283471584, -0.0728154182, 0.458126426, -0.0492827594, -0.389785051, -0.213810101, 0.270405948, -0.295325041, 0.163871646, -0.30711922, 0.163507402, 0.184971035, -0.372719765, -0.345449448, -0.228496328, 0.0936062336, 0.0391324759, 0.284702837, 0.357444406, -0.416430354, -0.491165191, 1.07041216, -0.202913612, 0.692038596, 0.704371512, -0.373513103, -0.401845783, 1.21737754, -0.425899148, -0.141014099, 0.292727947, -0.334978759, 0.967125177, -1.33363903, 0.22960031, -1.47661817, 1.4430207, -0.289626122, -0.17020148, -0.300850689, -0.333540708, -0.419849396, -1.11759806, 0.142602563, 1.46721053, -1.84906495, 0.158245802, -2.41259527, 0.874757349, 0.342971951, -0.173050821, -1.25909066, -0.401011527, -0.45153591, -1.89688873, -0.369080991, -0.30895066