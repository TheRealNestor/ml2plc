    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 1: Activation (RELU) *)
FOR i := 0 TO 15 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 2: MatMul *)
