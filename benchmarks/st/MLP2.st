    bias_1 : ARRAY[0..11] OF REAL := [0.775029242, 0.652564585, -0.0195141528, -0.103892364, 0.218318015, 0, 0, 0.617531419, 0.926826239, 0.243494168, -0.0194969047, 0.466596425];

    weights_2 : ARRAY[0..35] OF REAL := [1.53674638, 0.650443971, -2.73100352, -2.41177368, 0.246539474, 1.11767316, 0.0693496838, 0.135199055, 0.236659944, -0.520485878, -2.86257172, 2.66742325, 2.73928761, -2.98059797, -1.58891046, -0.607522249, 0.527527988, -0.511837304, 0.365902066, 0.251552165, -0.238491297, 1.75930834, -0.699681163, -2.42889714, 0.470251977, 0.96659559, -1.97967458, 2.30076146, -3.00771189, -0.681918621, 0.0695722401, 0.301136672, 0.0389953405, -2.33629489, 0.16664502, 1.18618262];
    bias_2 : ARRAY[0..2] OF REAL := [-0.479153514, 0.582090855, -0.426023394];

END_VAR

VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..11] OF REAL;
    buffer_1 : ARRAY[0..15] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 0 DO
        sum := sum + input_data[i] * weights_0[i * 16 + j];
    END_FOR;
    buffer_1[j] := MAX(sum + bias_0[j], 0.0);
END_FOR;

(* Layer 1: Fused Linear + RELU *)
FOR j := 0 TO 11 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_1[i * 12 + j];
    END_FOR;
    buffer_0[j] := MAX(sum + bias_1[j], 0.0);
END_FOR;

(* Layer 2: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 11 DO
        sum := sum + buffer_0[i] * weights_2[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_2[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
