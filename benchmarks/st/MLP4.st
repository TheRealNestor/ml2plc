(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Fused Linear + RELU *)
FOR j := 0 TO 11 DO
    sum := 0.0;
    FOR i := 0 TO 19 DO
        sum := sum + input_data[i] * weights_0[i * 12 + j];
    END_FOR;
    buffer_1[j] := MAX(sum + bias_0[j], 0.0);
