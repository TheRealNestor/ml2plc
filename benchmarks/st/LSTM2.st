VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..31] OF REAL;
    buffer_1 : ARRAY[0..31] OF REAL;
    c_state_0 : ARRAY[0..31] OF REAL;
    f_gate_0 : ARRAY[0..31] OF REAL;
    g_gate_0 : ARRAY[0..31] OF REAL;
    h_state_0 : ARRAY[0..31] OF REAL;
    i_gate_0 : ARRAY[0..31] OF REAL;
    o_gate_0 : ARRAY[0..31] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
