    weights_5 : ARRAY[0..95] OF REAL := [-0.619744122, -0.333182812, 0.0351820961, 0.446551681, 0.059136726, -0.996013939, 0.748391747, -0.313486695, -0.824563682, 1.02468288, 0.391314059, -1.88188934, -0.695089817, -0.119980678, 0.340749383, 0.0557956472, 0.0833403319, -0.542140305, 2.33781099, 0.233990014, -1.64332366, -1.43045688, 0.223704234, 1.4924165, 1.12407982, 0.52347976, -1.37305748, -1.53644228, 0.137240231, 0.971312702, -1.28791022, 0.225629717, 0.659651935, 0.476543427, 0.172778457, -1.1256237, -0.124587797, -0.323568642, 0.881644309, 0.649400532, -0.435170949, -1.43197298, 0.226330265, -0.664244771, 0.893148422, -1.18337429, -0.076867722, 0.922740519, -1.2975924, 1.16434598, -0.469938993, 0.54522115, -0.192176789, -0.728825927, 0.0987007394, -0.388409823, 0.590543807, 0.829065323, 0.693322897, -1.06006241, -0.522190273, 0.321064383, 0.329160422, 0.0815405548, -0.27678293, 0.420886487, 0.467247486, -0.502129912, 0.383809954, 0.556371152, 0.133159652, 0.127103224, 1.48322928, -0.509372234, -1.15087509, 0.609892964, -0.502500415, -0.305538416, 0.413332105, -0.608334422, 0.207846016, -1.06802368, -0.305856675, 1.50980401, 1.74171758, 0.318013787, -1.99433625, -0.0204618536, 0.00666878279, 0.524443567, 1.11804628, 0.138628885, -0.790279984, -1.29259658, -0.311788738, 2.49130964];
    bias_5 : ARRAY[0..2] OF REAL := [0.0941917822, 0.0472129658, -0.149475068];

END_VAR

VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..639] OF REAL;
    buffer_1 : ARRAY[0..639] OF REAL;
    c_state_1 : ARRAY[0..31] OF REAL;
    f_gate_1 : ARRAY[0..31] OF REAL;
    g_gate_1 : ARRAY[0..31] OF REAL;
    h_state_1 : ARRAY[0..31] OF REAL;
    i_gate_1 : ARRAY[0..31] OF REAL;
    o_gate_1 : ARRAY[0..31] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
    (* Transpose loop variables *)
    t0_d0 : DINT;
    t0_d1 : DINT;
    t0_d2 : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Transpose perm=(1, 0, 2)  (1, 20, 1) -> (20, 1, 1) *)
FOR t0_d0 := 0 TO 19 DO
    FOR t0_d1 := 0 TO 0 DO
        FOR t0_d2 := 0 TO 0 DO
            buffer_1[t0_d0 + t0_d1 + t0_d2] := input_data[t0_d1 * 20 + t0_d0 + t0_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 1: LSTM (hidden_size=32, input_size=1, seq_len=20) *)
(* Generating output: Y *)

(* Initialize states to zero *)
FOR j := 0 TO 31 DO
    h_state_1[j] := 0.0;
    c_state_1[j] := 0.0;
END_FOR;

(* Process 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Input Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_i[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_i[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_i[j];
        i_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_f[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_f[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_f[j];
        f_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_g[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_g[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_g[j];
        exp_val := EXP(2.0 * sum);
        g_gate_1[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_o[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_o[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_o[j];
        o_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 31 DO
        c_state_1[j] := f_gate_1[j] * c_state_1[j] + i_gate_1[j] * g_gate_1[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 31 DO
        exp_val := EXP(2.0 * c_state_1[j]);
        h_state_1[j] := o_gate_1[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 31 DO
        buffer_0[t * 32 + j] := h_state_1[j];
    END_FOR;
END_FOR;

(* Layer 2: Squeeze *)
FOR i := 0 TO 639 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 3: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 31 DO
    buffer_0[i] := buffer_1[i + 608];
END_FOR;

(* Layer 4: Squeeze *)
FOR i := 0 TO 31 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 5: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 31 DO
        sum := sum + buffer_1[i] * weights_5[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_5[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

