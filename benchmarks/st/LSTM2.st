    weights_5 : ARRAY[0..95] OF REAL := [2.0464561, 0.327223241, -1.46886885, 0.602299154, -0.595028579, -0.544217765, 0.40233621, 0.431816399, -0.587424815, 0.724454224, 0.217224583, -1.46624029, 0.999281347, 0.469061702, -0.806473792, 1.06710184, -0.455810577, -0.672287464, -0.150263369, 0.157706141, -0.413334221, 0.403047025, -0.347637087, 0.684545457, -0.687482536, 0.506855309, 0.518282175, -0.514469147, 0.417416304, 0.750862718, 1.19782317, 0.578148305, -2.76325178, 1.1581372, -0.998947084, 0.197997764, 1.94178724, -0.202958107, -1.48820996, 0.980261087, -0.9104653, -0.49153468, -0.182022214, -0.481268078, 0.254516125, 0.0840020627, 0.0651711822, -0.318249166, 1.28041637, -0.649504006, -1.78702664, 0.0628416389, -0.214907795, -0.209480241, -0.0100143487, 0.0776778683, -0.697782457, -0.224348843, 0.554242849, 0.185580105, 0.380419701, 0.702433467, -1.40740192, 0.343606651, -0.211636201, -0.984938085, -0.07890407, -0.0744921342, 0.703595221, 0.0338286869, -0.0148841133, -0.586733937, 0.637632012, -0.15322578, -1.1848042, 1.66856062, 0.0431350358, -2.30985498, -0.259720355, 0.17023465, 0.293305278, 0.152800068, 0.236894384, 0.0498824902, 0.0391575918, 0.36265716, -0.398902416, 0.0402269661, 0.112081327, -0.733141005, 1.71362782, -0.358889073, -1.2402128, 0.492159694, -0.999020815, 0.393818289];
    bias_5 : ARRAY[0..2] OF REAL := [0.11686112, -0.0199865717, -0.0918712541];

END_VAR

VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..639] OF REAL;
    buffer_1 : ARRAY[0..639] OF REAL;
    c_state_1 : ARRAY[0..31] OF REAL;
    f_gate_1 : ARRAY[0..31] OF REAL;
    g_gate_1 : ARRAY[0..31] OF REAL;
    h_state_1 : ARRAY[0..31] OF REAL;
    i_gate_1 : ARRAY[0..31] OF REAL;
    o_gate_1 : ARRAY[0..31] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
    (* Transpose loop variables *)
    t0_d0 : DINT;
    t0_d1 : DINT;
    t0_d2 : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Transpose perm=(1, 0, 2)  (1, 20, 1) -> (20, 1, 1) *)
FOR t0_d0 := 0 TO 19 DO
    FOR t0_d1 := 0 TO 0 DO
        FOR t0_d2 := 0 TO 0 DO
            buffer_1[t0_d0 + t0_d1 + t0_d2] := input_data[t0_d1 * 20 + t0_d0 + t0_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 1: LSTM (hidden_size=32, input_size=1, seq_len=20) *)
(* Generating output: Y *)

(* Initialize states to zero *)
FOR j := 0 TO 31 DO
    h_state_1[j] := 0.0;
    c_state_1[j] := 0.0;
END_FOR;

(* Process 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Input Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_i[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_i[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_i[j];
        i_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_f[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_f[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_f[j];
        f_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_g[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_g[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_g[j];
        exp_val := EXP(2.0 * sum);
        g_gate_1[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_o[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_o[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_o[j];
        o_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 31 DO
        c_state_1[j] := f_gate_1[j] * c_state_1[j] + i_gate_1[j] * g_gate_1[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 31 DO
        exp_val := EXP(2.0 * c_state_1[j]);
        h_state_1[j] := o_gate_1[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 31 DO
        buffer_0[t * 32 + j] := h_state_1[j];
    END_FOR;
END_FOR;

(* Layer 2: Squeeze *)
FOR i := 0 TO 639 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 3: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 31 DO
    buffer_0[i] := buffer_1[i + 608];
END_FOR;

(* Layer 4: Squeeze *)
FOR i := 0 TO 31 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 5: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 31 DO
        sum := sum + buffer_1[i] * weights_5[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_5[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

