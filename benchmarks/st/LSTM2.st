(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: LSTM (hidden_size=32, input_size=1, seq_len=1) *)
(* Generating output: Y *)

(* Initialize states to zero *)
FOR j := 0 TO 31 DO
    h_state_0[j] := 0.0;
    c_state_0[j] := 0.0;
END_FOR;

(* Process 1 timesteps *)
FOR t := 0 TO 0 DO

    (* Input Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + input_data * weights_0_i[j * 1 + i] ;
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_0[i] * recurrent_0_i[j * 32 + i] ;
        END_FOR;
    sum := sum + bias_0_i[j];
    i_gate_0[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + input_data * weights_0_f[j * 1 + i] ;
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_0[i] * recurrent_0_f[j * 32 + i] ;
        END_FOR;
    sum := sum + bias_0_f[j];
    f_gate_0[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + input_data * weights_0_g[j * 1 + i] ;
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_0[i] * recurrent_0_g[j * 32 + i] ;
        END_FOR;
    sum := sum + bias_0_g[j];
    exp_val := EXP(2.0 * sum);
    g_gate_0[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + input_data * weights_0_o[j * 1 + i] ;
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_0[i] * recurrent_0_o[j * 32 + i] ;
        END_FOR;
    sum := sum + bias_0_o[j];
    o_gate_0[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 31 DO
        c_state_0[j] := f_gate_0[j] * c_state_0[j] + i_gate_0[j] * g_gate_0[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 31 DO
        exp_val := EXP(2.0 * c_state_0[j]);
        h_state_0[j] := o_gate_0[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 31 DO
        buffer_0[t * 32 + j] := h_state_0[j];
    END_FOR;
END_FOR;

(* Layer 1: Squeeze *)
FOR i := 0 TO 31 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 2: Slice starts=[0] ends=[1] axes=[0] steps=[1] *)
FOR i := 0 TO 31 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 3: Squeeze *)
FOR i := 0 TO 31 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 4: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 31 DO
        sum := sum + buffer_1[i] * weights_4[i * 3 + j];
    END_FOR;
output_data[j] := sum + bias_4[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

