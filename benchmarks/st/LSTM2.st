    weights_5 : ARRAY[0..95] OF REAL := [-0.147895902, 0.720528305, 0.188047424, -0.293979317, 0.600988567, -0.608861387, 0.629351318, -0.753717542, 0.554747522, -0.556557953, 0.960790813, -0.375388205, -0.34164983, -0.120646857, 0.553580463, -0.0796459019, 0.595324159, -0.519495428, 0.28144303, -0.314315468, 0.160835326, 0.35907352, -0.0323654599, -0.715687275, -0.00437860051, 0.759721279, -0.642236948, 0.0157624613, -0.816243649, -0.251851052, -0.524839222, -0.410602629, 0.742474854, 0.256978124, 0.0401827209, 0.345921576, 0.0998573899, -0.76886785, 0.52596575, 0.565777659, 0.0322689265, -0.644109726, -0.588903308, -0.281279862, 0.322635353, 0.763040423, -0.784680903, 0.576732814, -0.146051154, 0.347021282, -0.0689351931, -0.187009037, -0.32667014, 0.342599481, 0.365800291, 0.789899945, -0.775110066, 0.733815968, -0.427657157, 0.496010005, -0.409812748, -0.118828051, 0.297242612, 0.676206708, -0.0322959758, -0.537522614, 0.35575366, 0.445817411, -0.526679158, 0.272143185, -0.355923504, 0.311212569, 0.19864814, -0.734831512, 0.584039688, -0.21825923, 0.501854539, -0.552208304, 0.548667371, -0.624363422, 0.0873440951, -0.632909894, 0.428008348, 0.222221345, 0.322297245, -0.0419833884, 0.284978986, -0.375960559, 0.711316228, -0.605952501, -0.747181118, 0.889095545, 0.258455694, 0.467558056, 0.454782486, -0.46620667];
    bias_5 : ARRAY[0..2] OF REAL := [-0.0799352676, 0.0662982762, 0.0347389877];

END_VAR

VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..639] OF REAL;
    buffer_1 : ARRAY[0..639] OF REAL;
    c_state_1 : ARRAY[0..31] OF REAL;
    f_gate_1 : ARRAY[0..31] OF REAL;
    g_gate_1 : ARRAY[0..31] OF REAL;
    h_state_1 : ARRAY[0..31] OF REAL;
    i_gate_1 : ARRAY[0..31] OF REAL;
    o_gate_1 : ARRAY[0..31] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
    (* Transpose loop variables *)
    t0_d0 : DINT;
    t0_d1 : DINT;
    t0_d2 : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Transpose perm=(1, 0, 2)  (1, 20, 1) -> (20, 1, 1) *)
FOR t0_d0 := 0 TO 19 DO
    FOR t0_d1 := 0 TO 0 DO
        FOR t0_d2 := 0 TO 0 DO
            buffer_1[t0_d0 + t0_d1 + t0_d2] := input_data[t0_d1 * 20 + t0_d0 + t0_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 1: LSTM (hidden_size=32, input_size=1, seq_len=20) *)
(* Generating output: Y *)

(* Initialize states to zero *)
FOR j := 0 TO 31 DO
    h_state_1[j] := 0.0;
    c_state_1[j] := 0.0;
END_FOR;

(* Process 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Input Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_i[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_i[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_i[j];
        i_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Forget Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_f[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_f[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_f[j];
        f_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_g[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_g[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_g[j];
        exp_val := EXP(2.0 * sum);
        g_gate_1[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Output Gate *)
    FOR j := 0 TO 31 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_o[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 31 DO
            sum := sum + h_state_1[i] * recurrent_1_o[j * 32 + i];
        END_FOR;
        sum := sum + bias_1_o[j];
        o_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 31 DO
        c_state_1[j] := f_gate_1[j] * c_state_1[j] + i_gate_1[j] * g_gate_1[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 31 DO
        exp_val := EXP(2.0 * c_state_1[j]);
        h_state_1[j] := o_gate_1[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 31 DO
        buffer_0[t * 32 + j] := h_state_1[j];
    END_FOR;
END_FOR;

(* Layer 2: Squeeze *)
FOR i := 0 TO 639 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 3: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 31 DO
    buffer_0[i] := buffer_1[i + 608];
END_FOR;

(* Layer 4: Squeeze *)
FOR i := 0 TO 31 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 5: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 31 DO
        sum := sum + buffer_1[i] * weights_5[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_5[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

