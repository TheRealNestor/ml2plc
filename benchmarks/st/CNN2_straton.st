    CONSTANT bias_4 : ARRAY[0..15] OF REAL := [-0.572320938, 0.92125988, 0, -0.668008447, -0.0212099608, -0.683593035, 0.877661526, -0.00925802812, -0.770627618, -0.646602035, -0.0580508858, 1.1763432, -0.788740337, 0.013612844, 0.81735152, 0.0297728758];
    CONSTANT weights_5 : ARRAY[0..47] OF REAL := [-1.33256125, -2.52432323, 2.51601458, 1.11391294, 0.405833364, -2.33917618, -0.480721056, -0.133476317, -0.54921937, -0.193033025, -2.28203177, 1.91754472, 0.397748679, -0.113165334, -0.150985092, -0.785932422, -2.09784079, 1.53782511, 2.05608654, -1.48629928, -1.10607696, -0.390215963, 0.399841517, -0.220064655, -0.284964085, -1.77597547, 1.28539562, -0.10082715, -1.92382205, 1.99926412, -1.75153351, 0.599202216, 0.712618589, 0.974887013, 0.391511202, -1.97333479, -0.591356277, -2.02217221, 1.07233334, -2.037678, 0.831515193, 0.0525496751, 2.4216156, -1.99865174, -1.20082796, -1.46833932, 1.22327602, 0.262024254];
    CONSTANT bias_5 : ARRAY[0..2] OF REAL := [0.389867276, 0.35399425, -0.76349467];
END_VAR

VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..9] OF REAL;
    buffer_1 : ARRAY[0..15] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Conv2D  in=1x1x1  out=10x1x1  kernel=1x1  stride=1x1  pad=(0, 0, 0, 0)  group=1 *)
FOR oc := 0 TO 9 DO
    FOR oh := 0 TO 0 DO
        FOR ow := 0 TO 0 DO
            sum := bias_0[oc];
            FOR ic := 0 TO 0 DO
                FOR kh := 0 TO 0 DO
                    FOR kw := 0 TO 0 DO
                        ih := oh * 1 - 0 + kh;
                        iw := ow * 1 - 0 + kw;
                        sum := sum + input_data[ic * 1 + ih * 1 + iw] * weights_0[oc * 1 + ic * 1 + kh * 1 + kw];
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 1 + oh * 1 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 1: Activation (RELU) *)
FOR i := 0 TO 9 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 2: Conv2D  in=10x1x1  out=10x1x1  kernel=1x1  stride=1x1  pad=(0, 0, 0, 0)  group=1 *)
FOR oc := 0 TO 9 DO
    FOR oh := 0 TO 0 DO
        FOR ow := 0 TO 0 DO
            sum := bias_2[oc];
            FOR ic := 0 TO 9 DO
                FOR kh := 0 TO 0 DO
                    FOR kw := 0 TO 0 DO
                        ih := oh * 1 - 0 + kh;
                        iw := ow * 1 - 0 + kw;
                        sum := sum + buffer_0[ic * 1 + ih * 1 + iw] * weights_2[oc * 10 + ic * 1 + kh * 1 + kw];
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 1 + oh * 1 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 3: Activation (RELU) *)
FOR i := 0 TO 9 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 4: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 9 DO
        sum := sum + buffer_0[i] * weights_4[i * 16 + j];
    END_FOR;
    buffer_1[j] := MAX(sum + bias_4[j], 0.0);
END_FOR;

(* Layer 5: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_5[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_5[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

