            exp_val := exp_val + h_state_0[i] * recurrent_0_h[j * 16 + i];
        END_FOR;
        sum := sum + r_gate_0[j] * (exp_val + bias_r_0_h[j]);
        sum := sum + bias_w_0_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_0[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 15 DO
        h_state_0[j] := u_gate_0[j] * h_state_0[j] + (1.0 - u_gate_0[j]) * h_new_0[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 15 DO
        buffer_0[t * 16 + j] := h_state_0[j];
    END_FOR;
END_FOR;

(* Layer 1: Squeeze *)
FOR i := 0 TO 15 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 2: Slice starts=[0] ends=[1] axes=[0] steps=[1] *)
FOR i := 0 TO 15 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 3: Squeeze *)
FOR i := 0 TO 15 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 4: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_1[i] * weights_4[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_4[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
