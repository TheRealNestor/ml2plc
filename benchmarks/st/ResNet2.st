VAR
    (* Merged variables from all regions *)
    buffer_0 : ARRAY[0..31] OF REAL;
    buffer_1 : ARRAY[0..31] OF REAL;
    buffer_2 : ARRAY[0..31] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
