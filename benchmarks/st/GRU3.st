    u_gate_5 : ARRAY[0..63] OF REAL;

    (* Temporary computation variables *)
    i : DINT;
    j : DINT;
    t : DINT;
    sum : REAL;
    (* Computation helpers *)
    max_val : REAL;
    exp_val : REAL;
    exp_sum : REAL;
    (* Spatial loop variables *)
    oc : DINT;
    oh : DINT;
    ow : DINT;
    ic : DINT;
    kh : DINT;
    kw : DINT;
    ih : DINT;
    iw : DINT;
    (* Transpose loop variables *)
    t0_d0 : DINT;
    t0_d1 : DINT;
    t0_d2 : DINT;
    t3_d0 : DINT;
    t3_d1 : DINT;
    t3_d2 : DINT;
    t4_d0 : DINT;
    t4_d1 : DINT;
    t4_d2 : DINT;
END_VAR

(* Forward pass execution *)

(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: Transpose perm=(1, 0, 2)  (1, 20, 1) -> (20, 1, 1) *)
FOR t0_d0 := 0 TO 19 DO
    FOR t0_d1 := 0 TO 0 DO
        FOR t0_d2 := 0 TO 0 DO
            buffer_1[t0_d0 + t0_d1 + t0_d2] := input_data[t0_d1 * 20 + t0_d0 + t0_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 1: GRU (hidden_size=64, input_size=1, seq_len=20) *)
(* Generating output: Y, linear_before_reset=1 *)

(* Initialize states to zero *)
FOR j := 0 TO 63 DO
    h_state_1[j] := 0.0;
END_FOR;

(* Process 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Reset Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_r[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_1[i] * recurrent_1_r[j * 64 + i];
        END_FOR;
        sum := sum + bias_1_r[j];
        r_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Update Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_u[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_1[i] * recurrent_1_u[j * 64 + i];
        END_FOR;
        sum := sum + bias_1_u[j];
        u_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Candidate (lbr=1): h'_t = tanh(Wx + r_t * (Rh + Rb_h) + Wb_h) *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_h[j * 1 + i];
        END_FOR;
        exp_val := 0.0;
        FOR i := 0 TO 63 DO
            exp_val := exp_val + h_state_1[i] * recurrent_1_h[j * 64 + i];
        END_FOR;
        sum := sum + r_gate_1[j] * (exp_val + bias_r_1_h[j]);
        sum := sum + bias_w_1_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_1[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 63 DO
        h_state_1[j] := u_gate_1[j] * h_state_1[j] + (1.0 - u_gate_1[j]) * h_new_1[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_0[t * 64 + j] := h_state_1[j];
    END_FOR;
END_FOR;

(* Layer 2: Squeeze *)
FOR i := 0 TO 1279 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 3: Transpose perm=(1, 0, 2)  (20, 1, 64) -> (1, 20, 64) *)
FOR t3_d0 := 0 TO 0 DO
    FOR t3_d1 := 0 TO 19 DO
        FOR t3_d2 := 0 TO 63 DO
            buffer_2[t3_d0 * 1280 + t3_d1 * 64 + t3_d2] := buffer_1[t3_d1 * 64 + t3_d0 * 64 + t3_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 4: Transpose perm=(1, 0, 2)  (1, 20, 64) -> (20, 1, 64) *)
FOR t4_d0 := 0 TO 19 DO
    FOR t4_d1 := 0 TO 0 DO
        FOR t4_d2 := 0 TO 63 DO
            buffer_0[t4_d0 * 64 + t4_d1 * 64 + t4_d2] := buffer_2[t4_d1 * 1280 + t4_d0 * 64 + t4_d2];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 5: GRU (hidden_size=64, input_size=64, seq_len=20) *)
(* Generating output: Y, linear_before_reset=1 *)

(* Initialize states to zero *)
FOR j := 0 TO 63 DO
    h_state_5[j] := 0.0;
END_FOR;

(* Process 20 timesteps *)
FOR t := 0 TO 19 DO

    (* Reset Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_r[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_r[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_r[j];
        r_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Update Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_u[j * 64 + i];
        END_FOR;
        FOR i := 0 TO 63 DO
            sum := sum + h_state_5[i] * recurrent_5_u[j * 64 + i];
        END_FOR;
        sum := sum + bias_5_u[j];
        u_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Candidate (lbr=1): h'_t = tanh(Wx + r_t * (Rh + Rb_h) + Wb_h) *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_h[j * 64 + i];
        END_FOR;
        exp_val := 0.0;
        FOR i := 0 TO 63 DO
            exp_val := exp_val + h_state_5[i] * recurrent_5_h[j * 64 + i];
        END_FOR;
        sum := sum + r_gate_5[j] * (exp_val + bias_r_5_h[j]);
        sum := sum + bias_w_5_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_5[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 63 DO
        h_state_5[j] := u_gate_5[j] * h_state_5[j] + (1.0 - u_gate_5[j]) * h_new_5[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_1[t * 64 + j] := h_state_5[j];
    END_FOR;
END_FOR;

(* Layer 6: Squeeze *)
FOR i := 0 TO 1279 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 7: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i + 1216];
END_FOR;

(* Layer 8: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 9: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_9[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_9[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
