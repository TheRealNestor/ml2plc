(* Region: r0 [ACYCLIC] *)
(* Acyclic Region r0 *)
(* Layer 0: GRU (hidden_size=64, input_size=1, seq_len=1) *)
(* Generating output: Y, linear_before_reset=1 *)

(* Initialize states to zero *)
FOR j := 0 TO 63 DO
    h_state_0[j] := 0.0;
END_FOR;

(* Process 1 timesteps *)
FOR t := 0 TO 0 DO

    (* Reset Gate *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
