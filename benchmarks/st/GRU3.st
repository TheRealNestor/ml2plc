(* Layer 9: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_9[i * 3 + j];
    END_FOR;
    buffer_1[j] := sum;
END_FOR;

(* Layer 10: Activation (SOFTMAX) *)
(* Softmax: find max *)
max_val := buffer_1[0];
FOR i := 1 TO 2 DO
    IF buffer_1[i] > max_val THEN
        max_val := buffer_1[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(buffer_1[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
