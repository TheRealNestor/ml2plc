        END_FOR;
        sum := sum + bias_5_u[j];
        u_gate_5[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Candidate (lbr=1): h'_t = tanh(Wx + r_t * (Rh + Rb_h) + Wb_h) *)
    FOR j := 0 TO 63 DO
        sum := 0.0;
        FOR i := 0 TO 63 DO
            sum := sum + buffer_0[t * 64 + i] * weights_5_h[j * 64 + i];
        END_FOR;
        exp_val := 0.0;
        FOR i := 0 TO 63 DO
            exp_val := exp_val + h_state_5[i] * recurrent_5_h[j * 64 + i];
        END_FOR;
        sum := sum + r_gate_5[j] * (exp_val + bias_r_5_h[j]);
        sum := sum + bias_w_5_h[j];
        exp_val := EXP(2.0 * sum);
        h_new_5[j] := (exp_val - 1.0) / (exp_val + 1.0);
    END_FOR;

    (* Hidden state: h_t = u_t * h_{t-1} + (1 - u_t) * h'_t *)
    FOR j := 0 TO 63 DO
        h_state_5[j] := u_gate_5[j] * h_state_5[j] + (1.0 - u_gate_5[j]) * h_new_5[j];
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 63 DO
        buffer_1[t * 64 + j] := h_state_5[j];
    END_FOR;
END_FOR;

(* Layer 6: Squeeze *)
FOR i := 0 TO 1279 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 7: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 63 DO
    buffer_1[i] := buffer_0[i + 1216];
END_FOR;

(* Layer 8: Squeeze *)
FOR i := 0 TO 63 DO
    buffer_0[i] := buffer_1[i];
END_FOR;

(* Layer 9: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_9[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_9[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
