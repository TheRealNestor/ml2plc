    (* Output Gate *)
    FOR j := 0 TO 13 DO
        sum := 0.0;
        FOR i := 0 TO 0 DO
            sum := sum + buffer_1[t * 1 + i] * weights_1_o[j * 1 + i];
        END_FOR;
        FOR i := 0 TO 13 DO
            sum := sum + h_state_1[i] * recurrent_1_o[j * 14 + i];
        END_FOR;
        sum := sum + bias_1_o[j];
        o_gate_1[j] := 1.0 / (1.0 + EXP(-sum));
    END_FOR;

    (* Cell state: c_t = f_t * c_{t-1} + i_t * g_t *)
    FOR j := 0 TO 13 DO
        c_state_1[j] := f_gate_1[j] * c_state_1[j] + i_gate_1[j] * g_gate_1[j];
    END_FOR;

    (* Hidden state: h_t = o_t * tanh(c_t) *)
    FOR j := 0 TO 13 DO
        exp_val := EXP(2.0 * c_state_1[j]);
        h_state_1[j] := o_gate_1[j] * ((exp_val - 1.0) / (exp_val + 1.0));
    END_FOR;

    (* Y output: Full sequence *)
    FOR j := 0 TO 13 DO
        buffer_0[t * 14 + j] := h_state_1[j];
    END_FOR;
END_FOR;

(* Layer 2: Squeeze *)
FOR i := 0 TO 279 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 3: Slice starts=[19] ends=[20] axes=[0] steps=[1] *)
FOR i := 0 TO 13 DO
    buffer_0[i] := buffer_1[i + 266];
END_FOR;

(* Layer 4: Squeeze *)
FOR i := 0 TO 13 DO
    buffer_1[i] := buffer_0[i];
END_FOR;

(* Layer 5: MatMul *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 13 DO
        sum := sum + buffer_1[i] * weights_5[i * 3 + j];
    END_FOR;
    buffer_0[j] := sum;
END_FOR;

(* Layer 6: Activation (SOFTMAX) *)
(* Softmax: find max *)
max_val := buffer_0[0];
FOR i := 1 TO 2 DO
    IF buffer_0[i] > max_val THEN
        max_val := buffer_0[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(buffer_0[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
