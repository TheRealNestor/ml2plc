    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 2: Conv2D  in=32x20x1  out=32x20x1  kernel=3x1  stride=1x1  pad=(1, 0, 1, 0)  group=1 *)
FOR oc := 0 TO 31 DO
    FOR oh := 0 TO 19 DO
        FOR ow := 0 TO 0 DO
            sum := bias_2[oc];
            FOR ic := 0 TO 31 DO
                FOR kh := 0 TO 2 DO
                    FOR kw := 0 TO 0 DO
                        ih := oh * 1 - 1 + kh;
                        iw := ow * 1 - 0 + kw;
                        IF (ih >= 0) AND (ih < 20) AND (iw >= 0) AND (iw < 1) THEN
                            sum := sum + buffer_0[ic * 20 + ih * 1 + iw] * weights_2[oc * 96 + ic * 3 + kh * 1 + kw];
                        END_IF;
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 20 + oh * 1 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 3: Activation (RELU) *)
FOR i := 0 TO 639 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 4: Conv2D  in=32x20x1  out=32x20x1  kernel=3x1  stride=1x1  pad=(1, 0, 1, 0)  group=1 *)
FOR oc := 0 TO 31 DO
    FOR oh := 0 TO 19 DO
        FOR ow := 0 TO 0 DO
            sum := bias_4[oc];
            FOR ic := 0 TO 31 DO
                FOR kh := 0 TO 2 DO
                    FOR kw := 0 TO 0 DO
                        ih := oh * 1 - 1 + kh;
                        iw := ow * 1 - 0 + kw;
                        IF (ih >= 0) AND (ih < 20) AND (iw >= 0) AND (iw < 1) THEN
                            sum := sum + buffer_0[ic * 20 + ih * 1 + iw] * weights_4[oc * 96 + ic * 3 + kh * 1 + kw];
                        END_IF;
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 20 + oh * 1 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 5: Activation (RELU) *)
FOR i := 0 TO 639 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 6: Transpose perm=(1, 2, 0)  (32, 20, 1) -> (20, 1, 32) *)
FOR t6_d0 := 0 TO 19 DO
    FOR t6_d1 := 0 TO 0 DO
        FOR t6_d2 := 0 TO 31 DO
            buffer_1[t6_d0 * 32 + t6_d1 * 32 + t6_d2] := buffer_0[t6_d2 * 20 + t6_d0 + t6_d1];
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 7: Fused Linear + RELU *)
FOR j := 0 TO 15 DO
    sum := 0.0;
    FOR i := 0 TO 639 DO
        sum := sum + buffer_1[i] * weights_7[i * 16 + j];
    END_FOR;
    buffer_0[j] := MAX(sum + bias_7[j], 0.0);
END_FOR;

(* Layer 8: Fused Linear + SOFTMAX *)
FOR j := 0 TO 2 DO
    sum := 0.0;
    FOR i := 0 TO 15 DO
        sum := sum + buffer_0[i] * weights_8[i * 3 + j];
    END_FOR;
    output_data[j] := sum + bias_8[j];
END_FOR;

(* Softmax: find max *)
max_val := output_data[0];
FOR i := 1 TO 2 DO
    IF output_data[i] > max_val THEN
        max_val := output_data[i];
    END_IF;
END_FOR;

(* Softmax: compute exponentials and sum *)
exp_sum := 0.0;
FOR i := 0 TO 2 DO
    output_data[i] := EXP(output_data[i] - max_val);
    exp_sum := exp_sum + output_data[i];
END_FOR;

(* Softmax: normalize *)
FOR i := 0 TO 2 DO
    output_data[i] := output_data[i] / exp_sum;
END_FOR;

END_FUNCTION_BLOCK
