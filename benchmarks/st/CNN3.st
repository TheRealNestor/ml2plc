    FOR oh := 0 TO 19 DO
        FOR ow := 0 TO 0 DO
            sum := bias_4[oc];
            FOR ic := 0 TO 31 DO
                FOR kh := 0 TO 2 DO
                    FOR kw := 0 TO 0 DO
                        ih := oh * 1 - 1 + kh;
                        iw := ow * 1 - 0 + kw;
                        IF (ih >= 0) AND (ih < 20) AND (iw >= 0) AND (iw < 1) THEN
                            sum := sum + buffer_0[ic * 20 + ih * 1 + iw] * weights_4[oc * 96 + ic * 3 + kh * 1 + kw];
                        END_IF;
                    END_FOR;
                END_FOR;
            END_FOR;
            buffer_1[oc * 20 + oh * 1 + ow] := sum;
        END_FOR;
    END_FOR;
END_FOR;

(* Layer 5: Activation (RELU) *)
FOR i := 0 TO 639 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 6: Transpose perm=(1, 2, 0)  (32, 20, 1) -> (20, 1, 32) *)
FOR t6_d0 := 0 TO 19 DO
    FOR t6_d1 := 0 TO 0 DO
        FOR t6_d2 := 0 TO 31 DO
            buffer_1[t6_d0 * 32 + t6_d1 * 32 + t6_d2] := buffer_0[t6_d2 * 20 + t6_d0 + t6_d1];
