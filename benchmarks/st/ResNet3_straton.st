FOR i := 0 TO 63 DO
    buffer_0[i] := MAX(buffer_1[i], 0.0);
END_FOR;

(* Layer 11: Fused Linear + RELU *)
FOR j := 0 TO 63 DO
    sum := 0.0;
    FOR i := 0 TO 63 DO
        sum := sum + buffer_0[i] * weights_11[i * 64 + j];
    END_FOR;
    buffer_2[j] := MAX(sum + bias_11[j], 0.0);
